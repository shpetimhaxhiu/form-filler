{
  "name": "form-filler",
  "version": "1.0.0",
  "description": "A JavaScript bookmarklet that uses OpenAI's GPT-4o-mini to automatically generate realistic sample data for any web form.",
  "main": "src/bookmarklet.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "start": "webpack serve --mode=development --open",
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "build:bookmarklet": "node scripts/generate-bookmarklet.js",
    "update-index": "node scripts/update-index.js",
    "update-index:gh-pages": "cross-env GITHUB_PAGES=true node scripts/update-index-gh-pages.js",
    "clean": "rimraf dist",
    "make-dist": "node -e \"require('fs').mkdirSync('dist', { recursive: true })\"",
    "prebuild": "npm run clean && npm run make-dist",
    "postbuild": "npm run build:bookmarklet && npm run update-index",
    "build:gh-pages": "npm run build && npm run update-index:gh-pages",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "bookmarklet",
    "form-filler",
    "openai",
    "gpt",
    "javascript",
    "automation"
  ],
  "author": {
    "name": "Shpetim Haxhiu",
    "email": "shpetim.h@gmail.com",
    "url": "https://pito.dev"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/shpetimhaxhiu/form-filler"
  },
  "dependencies": {
    "core-js": "^3.36.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.9.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "gh-pages": "^6.1.1",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
